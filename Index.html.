
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#111827">
  <title>Tush Phone | Smartphones & Accessories</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f4f6fa;
      color: #172033;
    }
    header {
      background: #111827;
      color: white;
      padding: 22px 16px;
      text-align: center;
    }
    header h1 { margin: 0 0 8px; }
    header p { margin: 0; color: #d1d5db; }
    .hero {
      padding: 28px 18px;
      text-align: center;
      background: #e0e7ff;
    }
    .hero h2 { margin-top: 0; }
    .search {
      display: block;
      width: 100%;
      max-width: 520px;
      margin: 18px auto 0;
      padding: 13px;
      border: 1px solid #cbd5e1;
      border-radius: 10px;
      font-size: 16px;
    }
    main { padding: 20px 14px; max-width: 1100px; margin: auto; }
    .categories {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-bottom: 20px;
    }
    .categories button, .order {
      border: 0;
      border-radius: 8px;
      padding: 11px 14px;
      cursor: pointer;
      font-size: 14px;
    }
    .categories button { background: #e2e8f0; }
    .categories button.active { background: #111827; color: white; }
    .products {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(145px, 1fr));
      gap: 14px;
    }
    .card {
      background: white;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 2px 9px #0000000c;
      padding-bottom: 14px;
    }
    .product-image {
      height: 130px;
      display: grid;
      place-items: center;
      background: #e9edf5;
      font-size: 52px;
    }
    .card h3, .card p { margin: 12px; }
    .price { font-weight: bold; color: #087443; }
    .order {
      display: block;
      margin: 12px;
      text-align: center;
      text-decoration: none;
      background: #087443;
      color: white;
    }
    .empty { padding: 25px; text-align: center; }
    footer {
      margin-top: 30px;
      background: #111827;
      color: white;
      padding: 25px 15px;
      text-align: center;
    }
  </style>
</head>
<body>
  <header>
    <h1>TUSH PHONE</h1>
    <p>Smartphones · Phone Accessories · Lipa Mdogo Mdogo</p>
  </header>

  <section class="hero">
    <h2>Your next phone starts here</h2>
    <p>Explore our products and order directly through WhatsApp.</p>
    <input class="search" id="search" type="search"
      placeholder="Search phones and accessories..."
      aria-label="Search products">
  </section>

  <main>
    <h2>Shop our products</h2>
    <div class="categories" id="categories">
      <button class="active" data-category="All">All</button>
      <button data-category="Smartphones">Smartphones</button>
      <button data-category="Accessories">Accessories</button>
      <button data-category="Solar">Solar & Appliances</button>
    </div>
    <div class="products" id="products"></div>
  </main>

  <footer>
    <h3>Tush Phone</h3>
    <p>Free delivery · WhatsApp or call 0710783901</p>
    <p>Ask us about available phones and payment plans.</p>
  </footer>

  <script>
    const WHATSAPP_NUMBER = "254710783901";
    let selectedCategory = "All";

    // Demo products only. Replace these with your real inventory.
    const demoProducts = [
      { name: "Smartphones", category: "Smartphones",
        price: "Ask for price", icon: "📱" },
      { name: "Phone Covers", category: "Accessories",
        price: "Ask for price", icon: "📱" },
      { name: "Screen Protectors", category: "Accessories",
        price: "Ask for price", icon: "🛡️" },
      { name: "Solar Products", category: "Solar",
        price: "Ask for price", icon: "☀️" },
      { name: "Laptops & Fridges", category: "Solar",
        price: "Ask for price", icon: "💻" }
    ];

    function renderProducts() {
      const query = document.getElementById("search").value.toLowerCase();
      const filtered = demoProducts.filter(product =>
        (selectedCategory === "All" ||
         product.category === selectedCategory) &&
        product.name.toLowerCase().includes(query)
      );

      const container = document.getElementById("products");
      container.replaceChildren();

      if (!filtered.length) {
        container.innerHTML = '<p class="empty">No matching products found.</p>';
        return;
      }

      filtered.forEach(product => {
        const card = document.createElement("article");
        card.className = "card";

        const image = document.createElement("div");
        image.className = "product-image";
        image.textContent = product.icon;

        const name = document.createElement("h3");
        name.textContent = product.name;

        const price = document.createElement("p");
        price.className = "price";
        price.textContent = product.price;

        const link = document.createElement("a");
        link.className = "order";
        link.target = "_blank";
        link.rel = "noopener";
        link.href = "https://wa.me/" + WHATSAPP_NUMBER +
          "?text=" + encodeURIComponent(
            "Hello Tush Phone, I'm interested in " + product.name
          );
        link.textContent = "Order on WhatsApp";

        card.append(image, name, price, link);
        container.append(card);
      });
    }

    document.getElementById("search").addEventListener("input", renderProducts);

    document.getElementById("categories").addEventListener("click", event => {
      if (event.target.tagName !== "BUTTON") return;
      selectedCategory = event.target.dataset.category;
      document.querySelectorAll(".categories button").forEach(button => {
        button.classList.toggle("active", button === event.target);
      });
      renderProducts();
    });

    renderProducts();
  </script>
</body>
</html>
